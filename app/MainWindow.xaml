<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MAV TechTools" Width="1440" Height="900" MinWidth="1060" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#070B12" Foreground="#E6EDF5"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#070B12"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#0A1019"/>
    <SolidColorBrush x:Key="CardBrush" Color="#0E1520"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#152033"/>
    <SolidColorBrush x:Key="LineBrush" Color="#1E2A3B"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#263449"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E6EDF5"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8A99AD"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#24A7E0"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#0E2A3A"/>
    <SolidColorBrush x:Key="OkBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="FailBrush" Color="#F87171"/>

    <!-- Plain dark button -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="#E6EDF5"/>
      <Setter Property="Background" Value="#0E1520"/>
      <Setter Property="BorderBrush" Value="#263449"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#162235"/>
                <Setter TargetName="B" Property="BorderBrush" Value="#3B4D66"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#24A7E0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Accent (primary) button -->
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="#04121A"/>
      <Setter Property="Background" Value="#24A7E0"/>
      <Setter Property="BorderBrush" Value="#24A7E0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#4DBCEB"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Top menu button; Tag="active" marks the current page -->
    <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A9B6C8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Style.Triggers>
        <Trigger Property="Tag" Value="active">
          <Setter Property="Background" Value="#0E2A3A"/>
          <Setter Property="BorderBrush" Value="#1D5A78"/>
          <Setter Property="Foreground" Value="#E6EDF5"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Sub-section tab; Tag="active" marks the current tab -->
    <Style x:Key="TabBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#8A99AD"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="16,0" MinHeight="42">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#E6EDF5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Tag" Value="active">
          <Setter Property="Foreground" Value="#E6EDF5"/>
          <Setter Property="BorderBrush" Value="#24A7E0"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Home tile -->
    <Style x:Key="TileBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#E6EDF5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Width" Value="280"/>
      <Setter Property="Margin" Value="0,0,16,16"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="#0E1520" BorderBrush="#1E2A3B" BorderThickness="1" CornerRadius="14" Padding="22" MinHeight="190">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#111C2B"/>
                <Setter TargetName="B" Property="BorderBrush" Value="#24A7E0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Checkbox -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E6EDF5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="8,7">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5" BorderBrush="#3B4D66" Background="#0A1019" VerticalAlignment="Top" Margin="0,1,10,0">
                  <Path x:Name="Tick" Data="M 3.5 9 L 7.5 13 L 14.5 5" Stroke="#04121A" StrokeThickness="2.2" Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Border>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#152033"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#24A7E0"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#24A7E0"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#24A7E0"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dark combo box (dropdown) -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="B" Background="#0A1019" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
              <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M 0 0 L 5 5 L 10 0" Stroke="#8A99AD" StrokeThickness="1.6"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#3B4D66"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E6EDF5"/>
      <Setter Property="BorderBrush" Value="#263449"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Style="{StaticResource ComboToggle}" BorderBrush="{TemplateBinding BorderBrush}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter IsHitTestVisible="False" Margin="12,0,32,0" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#0E1520" BorderBrush="#263449" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel IsItemsHost="True" Margin="4"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E6EDF5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="10,7">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="B" Property="Background" Value="#162235"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="B" Property="Background" Value="#0E2A3A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Search box -->
    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="#E6EDF5"/>
      <Setter Property="CaretBrush" Value="#E6EDF5"/>
      <Setter Property="Background" Value="#0E1520"/>
      <Setter Property="BorderBrush" Value="#263449"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,0">
              <Grid>
                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="#5D6B80" VerticalAlignment="Center" Margin="2,0" Visibility="Collapsed"/>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#24A7E0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thin rounded progress bar -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Foreground" Value="#24A7E0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="#1A2535" CornerRadius="3"/>
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim scrollbars -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#22364F" CornerRadius="4" Margin="2"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="MinHeight" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border Background="#22364F" CornerRadius="4" Margin="2"/>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header: logo, top menu, PC info -->
    <Border Grid.Row="0" BorderBrush="#1E2A3B" BorderThickness="0,0,0,1" Padding="20,12">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#0D1522" Offset="0"/>
          <GradientStop Color="#0A1019" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
          <Viewbox Width="38" Height="38" Margin="0,0,12,0">
            <Path x:Name="LogoPath" Fill="#24A7E0" Stretch="Uniform" Width="1280" Height="1280">
              <Path.Effect>
                <DropShadowEffect Color="#24A7E0" BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
              </Path.Effect>
            </Path>
          </Viewbox>
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="17" FontWeight="Bold"><Run Text="MAV Computers"/><Run Text=" LLC" Foreground="#8A99AD" FontSize="12" FontWeight="SemiBold"/></TextBlock>
            <TextBlock Text="TECHTOOLS" Foreground="#24A7E0" FontFamily="Consolas" FontSize="11" Margin="1,1,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border BorderBrush="#1E2A3B" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
            <TextBlock x:Name="PcText" Text="PC" Foreground="#C9D4E3" FontFamily="Consolas" FontSize="12"/>
          </Border>
          <Border x:Name="AdminChip" BorderBrush="#1F4D3D" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
            <TextBlock x:Name="AdminText" Text="Admin" Foreground="#34D399" FontFamily="Consolas" FontSize="12"/>
          </Border>
          <Border BorderBrush="#1E2A3B" BorderThickness="1" CornerRadius="12" Padding="10,4">
            <TextBlock x:Name="VersionText" Text="v0.1" Foreground="#8A99AD" FontFamily="Consolas" FontSize="12"/>
          </Border>
        </StackPanel>
        <WrapPanel x:Name="NavPanel" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="400"/>
      </Grid.ColumnDefinitions>

      <!-- Main page -->
      <ScrollViewer x:Name="MainScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Background>
          <RadialGradientBrush Center="0.7,0" GradientOrigin="0.7,0" RadiusX="0.8" RadiusY="0.5">
            <GradientStop Color="#0B1A26" Offset="0"/>
            <GradientStop Color="#070B12" Offset="1"/>
          </RadialGradientBrush>
        </ScrollViewer.Background>
        <StackPanel x:Name="PagePanel" Margin="32,26,32,40" MaxWidth="1240" HorizontalAlignment="Left"/>
      </ScrollViewer>

      <!-- Action Center -->
      <Border Grid.Column="1" Background="#0A1019" BorderBrush="#1E2A3B" BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="18,16,18,12">
            <DockPanel>
              <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Text="idle" Foreground="#8A99AD" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Text="Action Center" FontSize="17" FontWeight="SemiBold"/>
            </DockPanel>
            <ProgressBar x:Name="OverallBar" Minimum="0" Maximum="100" Value="0" Margin="0,10,0,10"/>
            <UniformGrid Columns="3">
              <Button x:Name="CancelBtn" Style="{StaticResource Btn}" Content="Cancel queued" MinHeight="34" FontSize="12" Margin="0,0,6,0" Padding="6,0"/>
              <Button x:Name="ClearBtn" Style="{StaticResource Btn}" Content="Clear finished" MinHeight="34" FontSize="12" Margin="0,0,6,0" Padding="6,0"/>
              <Button x:Name="LogsBtn" Style="{StaticResource Btn}" Content="Open logs" MinHeight="34" FontSize="12" Padding="6,0"/>
            </UniformGrid>
            <Border x:Name="RestartBanner" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,10" CornerRadius="10" Background="#1A160A" BorderBrush="#5A4A1F" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Restart recommended" Foreground="#FBBF24" FontWeight="SemiBold"/>
                <TextBlock x:Name="RestartWhyText" Foreground="#C9D4E3" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <UniformGrid Columns="2">
                  <Button x:Name="RestartNowBtn" Style="{StaticResource Btn}" Content="Restart in 60 s" MinHeight="32" Margin="0,0,6,0" Background="#FBBF24" Foreground="#1A1203" BorderBrush="#FBBF24" FontWeight="SemiBold"/>
                  <Button x:Name="RestartLaterBtn" Style="{StaticResource Btn}" Content="Later" MinHeight="32"/>
                </UniformGrid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Job list -->
          <Border Grid.Row="1" BorderBrush="#1E2A3B" BorderThickness="0,1,0,0">
            <Grid>
              <TextBlock x:Name="NoJobsText" Text="No actions yet. Pick tools and press Run selected, or use a quick action." Foreground="#8A99AD" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="30,0"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="JobList" Margin="12,10">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#0E1520" BorderBrush="{Binding Border}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                          <DockPanel>
                            <Border DockPanel.Dock="Right" BorderBrush="{Binding Color}" Background="{Binding ChipBg}" BorderThickness="1" CornerRadius="9" Padding="8,1" VerticalAlignment="Top" Margin="8,0,0,0">
                              <TextBlock Text="{Binding StatusText}" Foreground="{Binding Color}" FontFamily="Consolas" FontSize="11"/>
                            </Border>
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding Detail}" Foreground="#8A99AD" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                          </DockPanel>
                          <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Foreground="#8A99AD" FontFamily="Consolas" FontSize="11" Width="40" TextAlignment="Right"/>
                            <ProgressBar Value="{Binding Percent}" Maximum="100" Foreground="{Binding Color}" Height="5" VerticalAlignment="Center"/>
                          </DockPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Console -->
          <Border Grid.Row="2" Background="#05080D" BorderBrush="#1E2A3B" BorderThickness="0,1,0,0">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="14,8,10,4">
                <Button x:Name="CopyLogBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Copy" MinHeight="26" FontSize="11" Padding="10,0"/>
                <TextBlock Text="CONSOLE" Foreground="#8A99AD" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
              </DockPanel>
              <ListBox x:Name="ConsoleList" Background="Transparent" BorderThickness="0" Margin="6,0,4,6"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter Margin="8,1"/>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Foreground="#5D6B80" FontFamily="Consolas" FontSize="12" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
