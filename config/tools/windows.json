    {
      "id": "defsig",
      "type": "check",
      "tab": "updates",
      "section": "Update Now",
      "label": "Update Microsoft Defender definitions",
      "cmd": "Update-MpSignature",
      "info": "Gets the newest virus definitions. Skipped with a warning if another antivirus has replaced Defender.",
      "default": true,
      "script": [
        "Write-Step 'Updating Microsoft Defender definitions'",
        "$st = Get-MpComputerStatus -ErrorAction SilentlyContinue",
        "if (-not $st -or -not $st.AntivirusEnabled) { Write-Warn 'Microsoft Defender antivirus is not active on this PC (another antivirus may be in charge). Nothing to update.'; return }",
        "Update-MpSignature -ErrorAction Stop",
        "Write-Info ('Definitions now ' + (Get-MpComputerStatus).AntivirusSignatureVersion)"
      ]
    },
    {
      "id": "wudefer",
      "type": "choice",
      "tab": "updates",
      "section": "Update Policy",
      "label": "Feature update behavior",
      "info": "Holding back big yearly feature updates protects practice software that is not certified on the new version yet. Security updates still install.",
      "options": [
        {
          "value": "default",
          "label": "Windows default",
          "script": [
            "Write-Step 'Removing feature update deferral and pause'",
            "Remove-TTReg 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate' 'DeferFeatureUpdates','DeferFeatureUpdatesPeriodInDays'",
            "Remove-TTReg 'HKLM:\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings' 'PauseUpdatesStartTime','PauseUpdatesExpiryTime','PauseFeatureUpdatesStartTime','PauseFeatureUpdatesEndTime','PauseQualityUpdatesStartTime','PauseQualityUpdatesEndTime'"
          ]
        },
        {
          "value": "defer",
          "label": "Delay feature updates 365 days",
          "script": [
            "Write-Step 'Delaying feature updates by 365 days'",
            "Set-TTReg 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate' 'DeferFeatureUpdates' 1",
            "Set-TTReg 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate' 'DeferFeatureUpdatesPeriodInDays' 365"
          ]
        },
        {
          "value": "pause",
          "label": "Pause all updates for 7 days",
          "script": [
            "Write-Step 'Pausing Windows updates for 7 days'",
            "$from = (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')",
            "$to = (Get-Date).AddDays(7).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')",
            "foreach ($n in 'PauseUpdatesStartTime','PauseFeatureUpdatesStartTime','PauseQualityUpdatesStartTime') { Set-TTReg 'HKLM:\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings' $n $from 'String' }",
            "foreach ($n in 'PauseUpdatesExpiryTime','PauseFeatureUpdatesEndTime','PauseQualityUpdatesEndTime') { Set-TTReg 'HKLM:\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings' $n $to 'String' }",
            "Write-Info ('Updates paused until ' + (Get-Date).AddDays(7).ToString('yyyy-MM-dd'))"
          ]
        }
      ]
    },
    {
      "id": "activehours",
      "type": "check",
      "tab": "updates",
      "section": "Update Policy",
      "label": "Set active hours to 7 AM to 7 PM",
      "cmd": "reg: ActiveHoursStart=7, ActiveHoursEnd=19",
      "info": "Windows will not restart for updates during office hours.",
      "script": [
        "Write-Step 'Setting active hours to 7 AM - 7 PM'",
        "Set-TTReg 'HKLM:\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings' 'SmartActiveHoursState' 0",
        "Set-TTReg 'HKLM:\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings' 'ActiveHoursStart' 7",
        "Set-TTReg 'HKLM:\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings' 'ActiveHoursEnd' 19"
      ]
    },
    {
      "id": "wurestart",
      "type": "check",
      "tab": "updates",
      "section": "Update Policy",
      "label": "No automatic restart while someone is signed in",
      "cmd": "reg: WindowsUpdate\\AU NoAutoRebootWithLoggedOnUsers=1",
      "info": "Useful on front-desk and imaging PCs that must stay up during the day.",
      "script": [
        "Write-Step 'Blocking automatic restarts while a user is signed in'",
        "Set-TTReg 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU' 'NoAutoRebootWithLoggedOnUsers' 1"
      ]
    },
    {
      "id": "wuasap",
      "type": "check",
      "tab": "updates",
      "section": "Update Policy",
      "label": "Do not get updates as soon as they are released",
      "cmd": "reg: IsContinuousInnovationOptedIn=0",
      "info": "Turns off \"Get the latest updates as soon as they are available\", so new features arrive with the normal monthly updates.",
      "script": [
        "Write-Step 'Turning off early feature updates'",
        "Set-TTReg 'HKLM:\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings' 'IsContinuousInnovationOptedIn' 0"
