      "section": "System Files",
      "label": "Repair the Windows image (DISM)",
      "cmd": "DISM /Online /Cleanup-Image /RestoreHealth",
      "info": "Repairs the store SFC copies files from. Needs internet. Takes 5-20 minutes.",
      "scriptFile": "scripts/windows/dism.ps1"
    },
    {
      "id": "chkdsk",
      "type": "check",
      "tab": "repair",
      "section": "System Files",
      "label": "Check drive C: for errors (online scan)",
      "cmd": "chkdsk C: /scan",
      "info": "Read-mostly scan that runs while Windows is up. Tells you if an offline repair is needed.",
      "scriptFile": "scripts/windows/chkdsk.ps1"
    },
    {
      "id": "tempitem",
      "type": "check",
      "tab": "repair",
      "section": "Cleanup",
      "label": "Free up space on C:",
      "cmd": "Temp files, Windows Update cache, Delivery Optimization cache",
      "info": "Deletes temp files older than a day and the update download caches. Safe; shows space freed.",
      "default": true,
      "scriptFile": "scripts/windows/cleanup.ps1"
    },
    {
      "id": "iconcache",
      "type": "check",
      "tab": "repair",
      "section": "Cleanup",
      "label": "Rebuild icon cache",
      "cmd": "ie4uinit.exe -show",
      "info": "Fixes blank or wrong icons on the desktop and taskbar.",
      "script": [
        "Write-Step 'Rebuilding the icon cache'",
        "& (Join-Path $env:windir 'System32\\ie4uinit.exe') -show",
        "Write-Info 'Icon cache refreshed. Icons may flicker for a moment.'"
      ]
    },
    {
      "id": "spooler",
      "type": "check",
      "tab": "repair",
      "section": "Services & Printing",
      "label": "Clear stuck print jobs and restart spooler",
      "cmd": "Stop Spooler, clear spool folder, start Spooler",
      "info": "Deletes every waiting print job. Use when the queue is stuck.",
      "script": [
        "Write-Step 'Clearing stuck print jobs'",
        "$s = Clear-TTPrintQueue",
        "Write-Info $s.Summary",
        "if ($s.Level -eq 'warn') { Write-Warn 'Some spool files were locked. Restart the PC if jobs still will not clear.' }"
      ]
    },
    {
      "id": "explorer",
      "type": "check",
      "tab": "repair",
      "section": "Services & Printing",
      "label": "Restart Windows Explorer",
      "cmd": "Stop-Process explorer",
      "info": "Fixes a frozen taskbar, Start menu or desktop. Open File Explorer windows close.",
      "script": [
        "Write-Step 'Restarting Windows Explorer'",
        "Stop-Process -Name explorer -Force -ErrorAction SilentlyContinue",
        "Start-Sleep -Seconds 4",
        "if (-not (Get-Process -Name explorer -ErrorAction SilentlyContinue)) { Start-Process explorer.exe }",
        "Write-Info 'Explorer restarted'"
      ]
    },
    {
      "id": "defscan",
      "type": "check",
      "tab": "repair",
      "section": "Services & Printing",
      "label": "Run Microsoft Defender quick scan",
      "cmd": "Start-MpScan -ScanType QuickScan",
      "info": "Takes 2-10 minutes. Threats found are listed in the console.",
      "script": [
        "Write-Step 'Running Microsoft Defender quick scan'",
        "$st = Get-MpComputerStatus -ErrorAction SilentlyContinue",
        "if (-not $st -or -not $st.AntivirusEnabled) { Write-Warn 'Microsoft Defender antivirus is not active on this PC. Use the installed antivirus instead.'; return }",
        "Start-MpScan -ScanType QuickScan -ErrorAction Stop",
        "$t = @(Get-MpThreatDetection -ErrorAction SilentlyContinue | Where-Object { $_.InitialDetectionTime -gt (Get-Date).AddHours(-1) })",
        "if ($t.Count) { Write-Warn ('Threats found: ' + $t.Count + '. Open Windows Security > Protection history.') } else { Write-Info 'No threats found' }"
      ]
    }
  ]
}
